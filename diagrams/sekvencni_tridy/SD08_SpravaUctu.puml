@startuml SD08_SpravaUctu
' ============================================================
' SD08 – Správa uživatelských účtů
' Use case: Správa účtů – „Vytvořit účet“, „Přiřadit roli“,
'           „Reset hesla“ (vyžádá zaměstnanec nebo administrátor)
' Třídy: Uzivatel, Databaze, NotifikacniSluzba
' Pravidla (app.js):
'   - e-mail uživatele musí být v systému unikátní
'   - role: EMPLOYEE / MANAGER / ADMIN
' ============================================================
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #222222
skinparam SequenceLifeLineBorderColor #777777
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #222222
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #222222
skinparam BoundaryBackgroundColor #FFFFFF
skinparam BoundaryBorderColor #222222
skinparam SequenceGroupBorderColor #555555
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceReferenceBackgroundColor #F3F3F3
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #B5A642

title SD08 – Správa uživatelských účtů

actor "Administrátor" as A
participant "__:Databaze__" as DB
participant "__u:Uzivatel__" as U
boundary "__:NotifikacniSluzba__\n«IS e-mail»" as NS
actor "Zaměstnanec" as Z

== Vytvoření účtu (administrátor) ==

A -> DB : existujeEmail(email) : boolean
activate DB
DB --> A : existuje
deactivate DB
break existuje = true
  A <-- DB : chyba – uživatel s tímto e-mailem již existuje
end

create U
A -> U : «create» Uzivatel(jmeno, email, telefon)
A -> U : nastavRoli(role)
A -> U : nastavOpravneni(canDrive)
A -> DB : ulozUzivatele(u)
A -> U : resetovatHeslo()
activate U
U -> U : token := vygenerujToken()
U -> NS : odeslat(u.email, "Účet vytvořen – nastavte si heslo")
activate NS
NS -> Z : e-mail: odkaz pro nastavení hesla
deactivate NS
deactivate U

== Reset hesla (zaměstnanec) ==

Z -> DB : najdiUzivatele(email) : Uzivatel
activate DB
DB --> Z : u
deactivate DB
break u = null
  Z <-- DB : chyba – e-mail nebyl nalezen
end
Z -> U : resetovatHeslo()
activate U
U -> U : token := vygenerujToken()
U -> DB : ulozUzivatele(u)
U -> NS : odeslat(u.email, "Odkaz pro obnovu hesla")
activate NS
NS -> Z : e-mail: odkaz pro obnovu hesla
deactivate NS
U --> Z : instrukce odeslány
deactivate U

@enduml
