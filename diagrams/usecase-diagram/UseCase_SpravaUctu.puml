@startuml
left to right direction
skinparam packageStyle rectangle

actor "Administrátor" as Admin
actor "Zaměstnanec" as Emp

rectangle "Správa uživatelů a přístupů (Car-side)" {

    usecase "Vytvoření uživatelského účtu" as UC1
    usecase "Přiřazení role\n(Zaměstnanec / Manažer)" as UC2
    usecase "Deaktivace / smazání účtu" as UC3
    usecase "Reset hesla" as UC4

    usecase "Ověření identity při přihlášení" as UC_Auth
}

' Propojení Administrátora
Admin --> UC1
Admin --> UC2
Admin --> UC3

' Propojení Zaměstnance
Emp --> UC4

' Závislosti (include)
UC1 ..> UC_Auth : <<include>>
UC4 ..> UC_Auth : <<include>>

@enduml
