@startuml
left to right direction
skinparam packageStyle rectangle

actor "Zaměstnanec" as Emp
actor "Správce vozového parku\n(Fleet Manager)" as Manager

rectangle "Provoz a stav vozidla" {
    usecase "Kontrola stavu při převzetí / vrácení" as UC_CheckState
    usecase "Zadání stavu tachometru a paliva" as UC_Fuel
    usecase "Hlášení závady nebo poškození vozidla" as UC_Incident
    usecase "Řešení škody / servisu" as UC_Resolve
}

' Zaměstnanec
Emp --> UC_CheckState
Emp --> UC_Incident

' Správce
Manager --> UC_Resolve

' Závislosti
UC_CheckState ..> UC_Fuel : <<include>>
UC_Incident ..> UC_CheckState : <<extend>>
UC_Incident ..> UC_Resolve : <<include>>

@enduml
