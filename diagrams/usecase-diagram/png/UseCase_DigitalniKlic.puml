@startuml
left to right direction
skinparam packageStyle rectangle

actor "Zaměstnanec" as Emp
actor "Správce vozového parku\n(Fleet Manager)" as Admin

rectangle "Digitální přístup k vozidlu" {
    usecase "Digitální odemčení / zamknutí\nvozidla" as UC_Unlock
    usecase "Hlášení ztráty zařízení / klíče" as UC_ReportLoss
    usecase "Blokace přístupu k vozidlu" as UC_BlockAccess
    usecase "Obnovení přístupu k vozidlu" as UC_Restore
}

' Propojení rolí
Emp --> UC_Unlock
Emp --> UC_ReportLoss
Admin --> UC_BlockAccess
Admin --> UC_Restore

' Závislosti
UC_ReportLoss ..> UC_BlockAccess : <<include>>

@enduml
