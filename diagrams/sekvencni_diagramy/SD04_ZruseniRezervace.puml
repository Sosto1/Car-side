@startuml SD04_ZruseniRezervace
' ============================================================
' SD04 – Zrušení potvrzené rezervace správcem
' Kód: src/app.js        managerDecision(resId, false, true)
'      src/services.js   ReservationService.cancel(), changeStatus(), isBlocking()
' Pravidla:
'   - zrušit lze jen potvrzenou rezervaci: CONFIRMED -> CANCELLED
'   - zrušená rezervace přestane blokovat vozidlo (isBlocking = false)
' ============================================================
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #222222
skinparam SequenceLifeLineBorderColor #777777
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #222222
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #222222
skinparam SequenceGroupBorderColor #555555
skinparam SequenceGroupHeaderFontStyle bold
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #B5A642

title SD04 – Zrušení rezervace správcem

actor "Správce\nvozového parku" as S
participant "app.js\n«UI»" as UI
participant "__rs:ReservationService__" as RS
participant "db\n«data v paměti»" as D
participant "__log:AuditLog__" as LOG
participant "__ns:NotificationService__" as NS
participant "__store:LocalStore__" as ST

S -> UI : klikne „Zrušit“ u potvrzené rezervace\n(záložka „Všechny rezervace“)
activate UI
UI -> S : confirm("Opravdu chcete zrušit…?")

break správce dialog zruší
  UI --> S : nic se nezmění
end

UI -> RS : cancel(resId)
activate RS
RS -> RS : changeStatus(resId, CANCELLED, "CANCEL", "zrušena správcem")
RS -> D : najdi rezervaci podle resId
D --> RS : rec

break rec.status <> CONFIRMED
  RS --> UI : Error("nelze změnit stav")
  UI --> S : alert(hláška)
end

RS -> LOG : record("PUT /reservations/{id}/status (CANCEL)")
RS -> RS : rec.status = CANCELLED
note right of RS : isBlocking(rec) = false\n→ vozidlo je v termínu opět volné
RS -> NS : send(rec.employeeEmail, "rezervace byla zrušena správcem")
RS --> UI : rec
deactivate RS

UI -> ST : save(db)
UI -> UI : renderAll()
UI --> S : rezervace je v sekci „Zamítnuté a zrušené“
deactivate UI

@enduml
