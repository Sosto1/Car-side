@startuml
|Zaměstnanec|
start
:Zadání požadavku na vytvoření rezervace;

|Systém|
:Kontrola dostupnosti vozidla;
:Ověření způsobilosti uživatele (1 rok bez nehody);

if (Vozidlo dostupné AND Uživatel způsobilý?) then (ano)
  :Uložení rezervace\n(Stav: DRAFT -> PENDING);
  
  |Emailová služba|
  :Odeslání emailového oznámení\no nové rezervaci;
  
  |Správce vozového parku|
  :Schvalování / Zamítání rezervací;
  
  if (Rozhodnutí správce) then (Schváleno)
    |Emailová služba|
    :Odeslání emailového oznámení\n(Rezervace schválena);
    
    |Zaměstnanec|
    :Převzetí vozidla;
    :Užívání vozidla;
    :Vrácení vozidla;
    stop
    
  else (Zamítnuto)
    |Emailová služba|
    :Odeslání emailového oznámení\n(Rezervace zamítnuta);
    stop
  endif
  
else (ne)
  |Systém|
  :Zobrazení chyby\n(Nedostupné vozidlo nebo chybí způsobilost);
  stop
endif
@enduml